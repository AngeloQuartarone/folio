{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "group": "build",
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
        "background": {
          "activelyBeginsPattern": "^\\[watch\\] build started",
          "activelyEndsPattern": "^\\[watch\\] build finished"
        }
      }
    }
  ]
}
