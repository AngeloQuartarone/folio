{
  "name": "markdown-translate-preview",
  "displayName": "Markdown Translate Preview",
  "description": "A lean Markdown preview with themes, scroll sync, PDF export and on-the-fly translation of selected text.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "translate",
    "translation",
    "pdf"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "markdownTranslate.openPreviewToTheSide",
        "title": "Open Preview to the Side",
        "category": "Markdown Translate",
        "icon": {
          "light": "./media/preview-right-light.svg",
          "dark": "./media/preview-right-dark.svg"
        }
      },
      {
        "command": "markdownTranslate.openPreview",
        "title": "Open Preview",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.syncPreview",
        "title": "Sync Preview to Cursor",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.toggleScrollSync",
        "title": "Toggle Scroll Sync",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.selectPreviewTheme",
        "title": "Select Preview Theme",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.selectCodeBlockTheme",
        "title": "Select Code Block Theme",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.exportPdf",
        "title": "Export PDF",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.exportHtml",
        "title": "Export HTML",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.setApiKey",
        "title": "Set API Key",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.setTargetLanguage",
        "title": "Set Target Language",
        "category": "Markdown Translate"
      },
      {
        "command": "markdownTranslate.toggleTranslation",
        "title": "Toggle Translation Tooltips",
        "category": "Markdown Translate"
      }
    ],
    "configuration": {
      "title": "Markdown Translate Preview",
      "properties": {
        "markdownTranslate.enabled": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "description": "Show a translation tooltip when you select text in the preview."
        },
        "markdownTranslate.targetLanguage": {
          "type": "string",
          "default": "it",
          "order": 1,
          "pattern": "^[A-Za-z]{2,3}([-_][A-Za-z0-9]{2,8})?$",
          "patternErrorMessage": "Use a language code such as \"it\", \"en\", \"de\" or \"pt-BR\".",
          "markdownDescription": "Language to translate into, as a code: `it`, `en`, `de`, `fr`, `es`, `pt-BR`, `ja`, `zh`… The source language is detected automatically."
        },
        "markdownTranslate.provider": {
          "type": "string",
          "enum": [
            "deepl",
            "libretranslate"
          ],
          "enumDescriptions": [
            "DeepL API Free or Pro (the endpoint is chosen from the key).",
            "LibreTranslate server (self-hosted or libretranslate.com)."
          ],
          "default": "deepl",
          "order": 2,
          "markdownDescription": "Translation service. Set its API key with the **Markdown Translate: Set API Key** command (stored in the OS keychain, not in settings)."
        },
        "markdownTranslate.libreTranslateUrl": {
          "type": "string",
          "default": "https://libretranslate.com",
          "order": 3,
          "markdownDescription": "Base URL of the LibreTranslate server, e.g. `http://localhost:5000`. The API key is optional and set with **Markdown Translate: Set API Key**."
        },
        "markdownTranslate.previewTheme": {
          "type": "string",
          "enum": [
            "github-light.css",
            "github-dark.css",
            "sepia.css",
            "newsprint.css",
            "atom-light.css",
            "atom-dark.css",
            "atom-material.css",
            "one-light.css",
            "one-dark.css",
            "solarized-light.css",
            "solarized-dark.css",
            "gothic.css",
            "medium.css",
            "monokai.css",
            "night.css",
            "vue.css",
            "vscode.css"
          ],
          "default": "github-light.css",
          "description": "Theme of the preview. \"sepia\" is a warm reading theme; \"vscode\" follows the editor colors."
        },
        "markdownTranslate.codeBlockTheme": {
          "type": "string",
          "enum": [
            "auto.css",
            "atom-dark.css",
            "atom-light.css",
            "atom-material.css",
            "coy.css",
            "darcula.css",
            "dark.css",
            "default.css",
            "funky.css",
            "github.css",
            "github-dark.css",
            "hopscotch.css",
            "monokai.css",
            "okaidia.css",
            "one-dark.css",
            "one-light.css",
            "pen-paper-coffee.css",
            "pojoaque.css",
            "solarized-dark.css",
            "solarized-light.css",
            "twilight.css",
            "vs.css",
            "vscode.css",
            "vue.css",
            "xonokai.css"
          ],
          "default": "auto.css",
          "description": "Syntax highlighting theme of code blocks. \"auto\" picks the one matching the preview theme."
        },
        "markdownTranslate.previewColorScheme": {
          "type": "string",
          "enum": [
            "selectedPreviewTheme",
            "editorColorScheme",
            "systemColorScheme"
          ],
          "enumDescriptions": [
            "Always use the selected preview theme.",
            "Switch paired themes (github, atom, one, solarized) to their light/dark variant following the editor theme.",
            "Switch paired themes following the operating system appearance."
          ],
          "default": "editorColorScheme",
          "description": "How light and dark variants of the preview theme are chosen."
        },
        "markdownTranslate.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Synchronize scrolling between the editor and the preview."
        },
        "markdownTranslate.liveUpdateDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Delay in milliseconds before the preview updates after an edit."
        },
        "markdownTranslate.breakOnSingleNewLine": {
          "type": "boolean",
          "default": false,
          "description": "Render a single line break as <br> (GitHub does not)."
        },
        "markdownTranslate.math.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render $...$ and $$...$$ math with KaTeX."
        },
        "markdownTranslate.mermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render ```mermaid code blocks as diagrams."
        },
        "markdownTranslate.chromePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path of Chrome, Chromium, Edge or Brave used for PDF export. Leave empty to detect it automatically."
        }
      }
    },
    "keybindings": [
      {
        "command": "markdownTranslate.openPreviewToTheSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markdownTranslate.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownTranslate.openPreviewToTheSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdownTranslate.openPreviewToTheSide",
          "when": "editorLangId == markdown",
          "group": "markdownTranslate@1"
        },
        {
          "command": "markdownTranslate.exportPdf",
          "when": "editorLangId == markdown",
          "group": "markdownTranslate@2"
        },
        {
          "command": "markdownTranslate.exportHtml",
          "when": "editorLangId == markdown",
          "group": "markdownTranslate@3"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownTranslate.openPreviewToTheSide",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownTranslate.openPreviewToTheSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownTranslate.openPreview",
          "when": "editorLangId == markdown"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node scripts/build.mjs --tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && node scripts/build.mjs --tests && node scripts/run-integration-tests.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "less": "^4.9.1",
    "mermaid": "^12.0.0",
    "mocha": "^12.0.2",
    "typescript": "^7.0.2"
  }
}
